# SignUpGenius Pro API key (Account > API Access)
SUG_API_KEY=

# Title prefix used to identify the canteen sign-up among all active sign-ups.
# Override with CANTEEN_SIGNUP_ID below if titles aren't consistent.
CANTEEN_TITLE_PREFIX=Canteen Volunteer

# Optional: force a specific canteen signupid instead of matching by title.
CANTEEN_SIGNUP_ID=

# Where to write the generated data.json (relative to repo root).
OUTPUT_PATH=dist/data.json
